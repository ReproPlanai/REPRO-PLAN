# =============================================================================
# REPRO PLAN - Backend Environment Configuration (Fortune 500 Grade)
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# -----------------------------------------------------------------------------
# Frontend URL (for CORS, email links, redirects)
# Production: https://your-app.vercel.app
# -----------------------------------------------------------------------------
FRONTEND_URL=https://repro-plan.vercel.app

# -----------------------------------------------------------------------------
# Database (Railway PostgreSQL)
# Format: postgres://user:password@host:port/database
# Railway provides this automatically via DATABASE_URL env var
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/repro_plan
# DATABASE_URL=${{Postgres.DATABASE_URL}}  # Railway template syntax

# -----------------------------------------------------------------------------
# Redis (Railway Redis) - Optional, for caching & sessions
# -----------------------------------------------------------------------------
REDIS_URL=redis://default:PASSWORD@reproplanredisdb.railway.internal:6379
REDIS_PASSWORD=
REDISHOST=reproplanredisdb.railway.internal
REDISPORT=6379
REDISUSER=default

# -----------------------------------------------------------------------------
# Email Service (Resend)
# Get API key from: https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxx
EMAIL_FROM=REPRO PLAN <info@reproplan.com>
BRAND_LOGO_URL=https://reproplanai.com/logo512.png

# -----------------------------------------------------------------------------
# AI Provider Configuration
# Gemini is primary, Claude is fallback for health-sensitive content
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini (Primary)
# Get API key from: https://makersuite.google.com/app/apikey
# Enable billing early (even at $0 spend) to prevent SRHR content from being used in model training
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Anthropic Claude (Fallback for health-sensitive content)
# Get API key from: https://console.anthropic.com
# Free tier: 5 RPM / 10K input TPM / 4K output TPM (shared across all models)
ANTHROPIC_API_KEY=

# NVIDIA NIM API (Multi-provider fallback system)
# Get API keys from: https://build.nvidia.com/
# Each model has its own API key for independent rate limits
NVIDIA_MISTRAL_API_KEY=
NVIDIA_PHI_API_KEY=
NVIDIA_GEMMA_27B_API_KEY=
NVIDIA_GEMMA_2B_API_KEY=
NVIDIA_QWEN_API_KEY=
NVIDIA_JAMBA_API_KEY=

# NVIDIA Safety Guardrails
NVIDIA_GUARDIAN_API_KEY=
NVIDIA_SHIELDGEMMA_API_KEY=
NVIDIA_LLAMAGUARD_API_KEY=

# Development Mode
# When true, routes all AI calls to Gemini to preserve Claude free tier for staging/production
# Set to true in local development, false in staging/production
DEV_MODE=false

# -----------------------------------------------------------------------------
# Security Configuration (Fortune 500 Grade)
# -----------------------------------------------------------------------------
# JWT Secret for token signing (generate strong random string)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# Bcrypt salt rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000,https://repro-plan.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session configuration
SESSION_SECRET=another-super-secret-session-key
SESSION_MAX_AGE=86400000

# -----------------------------------------------------------------------------
# Monitoring & Observability (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# DataDog API key for metrics
# DATADOG_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_AI_FEATURES=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_RATE_LIMITING=true
ENABLE_REQUEST_LOGGING=true

# -----------------------------------------------------------------------------
# File Upload Configuration
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# -----------------------------------------------------------------------------
# External Data Integrations
# -----------------------------------------------------------------------------
# For third-party API connections (if needed)
# EXTERNAL_API_KEY=
# EXTERNAL_API_URL=
