# =============================================================================
# REPRO PLAN - Frontend Environment Configuration (Fortune 500 Grade)
# =============================================================================
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds
# NEVER commit .env files with real values to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API URL
# This is the URL where your Railway backend is deployed
# -----------------------------------------------------------------------------
# Local Development
REACT_APP_API_URL=http://localhost:8080

# Production (Railway Backend)
# REACT_APP_API_URL=https://repro-plan-server-production.up.railway.app

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment name
REACT_APP_ENVIRONMENT=development

# Application name (used in titles, meta tags)
REACT_APP_NAME=REPRO PLAN

# App version (should match package.json)
REACT_APP_VERSION=3.0.0

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable AI features
REACT_APP_ENABLE_AI=true

# Mapbox Access Token for map features
REACT_APP_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
# Mapbox Access Key (alternative naming)
REACT_APP_MAPBOX_ACCESS_KEY=your_mapbox_access_key_here

# Enable/disable analytics
REACT_APP_ENABLE_ANALYTICS=false

# Enable/disable service worker (PWA)
REACT_APP_ENABLE_PWA=true

# Enable/disable offline mode
REACT_APP_ENABLE_OFFLINE=true

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
# Google Analytics Measurement ID
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# REACT_APP_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# -----------------------------------------------------------------------------
# Build Configuration (Production only)
# Set in Vercel dashboard or .env.production file
# -----------------------------------------------------------------------------
# Disable source maps in production for smaller builds
# GENERATE_SOURCEMAP=false

# Enable production optimizations
# REACT_APP_PRODUCTION_OPTIMIZATIONS=true
